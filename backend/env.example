# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# Pinecone Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment_here
PINECONE_INDEX_NAME=rag-documents

# Application Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_RETRIEVAL_RESULTS=5

# Legal Document Intelligence (model must support JSON output and image input for OCR)
LEGAL_MODEL=gpt-4.1-mini
LEGAL_OCR_MAX_PAGES=30
LEGAL_FULL_TEXT_QA_CHARS=60000
# Documents per upload batch and parallel analysis workers (raise for larger corpora)
LEGAL_MAX_BATCH_DOCS=100
LEGAL_MAX_FILE_MB=25
LEGAL_WORKERS=4

# Engineering drawing agent (vision model; review reads up to ENGINEERING_MAX_PAGES sheets)
ENGINEERING_MODEL=gpt-4.1
ENGINEERING_MAX_PAGES=6
ENGINEERING_MAX_FILE_MB=50

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# Authentication and admin
# Browser origins allowed to call the API with cookies (comma-separated, no trailing slash)
FRONTEND_ORIGINS=http://localhost:3001
SESSION_TTL_HOURS=168
# Set to True when serving over HTTPS
COOKIE_SECURE=False
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=10
# First-party, cookie-less website page-view analytics
ANALYTICS_ENABLED=True
