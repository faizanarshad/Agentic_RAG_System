# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
# Optional: any OpenAI-compatible endpoint, so documents stay in your infrastructure. Examples:
#   Azure OpenAI (your tenant):  https://<resource>.openai.azure.com/openai/v1/
#   Self-hosted (vLLM/Ollama):   http://localhost:11434/v1
# Empty = api.openai.com. Set the model names above to ones the endpoint serves.
OPENAI_BASE_URL=

# Pinecone Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment_here
PINECONE_INDEX_NAME=rag-documents

# Application Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_RETRIEVAL_RESULTS=5

# Legal Document Intelligence (model must support JSON output and image input for OCR)
LEGAL_MODEL=gpt-4.1-mini
LEGAL_OCR_MAX_PAGES=30
LEGAL_FULL_TEXT_QA_CHARS=60000
# Documents per upload batch and parallel analysis workers (raise for larger corpora)
LEGAL_MAX_BATCH_DOCS=100
LEGAL_MAX_FILE_MB=25
LEGAL_WORKERS=4

# Engineering drawing agent (vision model; review reads up to ENGINEERING_MAX_PAGES sheets)
ENGINEERING_MODEL=gpt-4.1
ENGINEERING_MAX_PAGES=6
ENGINEERING_MAX_FILE_MB=50

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# Authentication and admin
# Browser origins allowed to call the API with cookies (comma-separated, no trailing slash)
FRONTEND_ORIGINS=http://localhost:3001
SESSION_TTL_HOURS=168
# Set to True when serving over HTTPS
COOKIE_SECURE=False
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=10
# First-party, cookie-less website page-view analytics
ANALYTICS_ENABLED=True

# Blog / site settings: the API asks the website to refresh cached pages after changes.
# Use the same random secret in frontend/.env.local (REVALIDATE_SECRET).
SITE_REVALIDATE_URL=http://localhost:3001/api/revalidate
REVALIDATE_SECRET=
UPLOAD_MAX_MB=8

# Deployment safety. With ENVIRONMENT=production the API refuses to start unless: COOKIE_SECURE=True,
# FRONTEND_ORIGINS are https-only, REVALIDATE_SECRET is 32+ chars, TRUSTED_PROXIES and DATA_ENCRYPTION_KEY are set.
ENVIRONMENT=development
# IPs of your reverse proxy/load balancer (their X-Forwarded-For header is trusted), e.g. 127.0.0.1
TRUSTED_PROXIES=
# 32-byte base64 key for encrypting 2FA secrets at rest. Generate:
#   python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
DATA_ENCRYPTION_KEY=

# Emailed links (invitations, password resets). Without SMTP the admin panel shows the link to pass on.
PUBLIC_SITE_URL=http://localhost:3001
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RESET_TOKEN_MINUTES=60
INVITE_TOKEN_HOURS=72

# Medical data: replace emails, phone numbers, SSNs, MRNs and full dates in uploaded text before it is
# embedded or sent to the model provider
MEDICAL_REDACT_PHI=True

# Upload safety: page limit for PDFs, and virus scanning with ClamAV (clamdscan/clamscan) when installed.
# VIRUS_SCAN=auto scans when ClamAV is available, required rejects uploads if it is not, off disables.
MAX_PDF_PAGES=1000
VIRUS_SCAN=auto

# Automatic backups (python manage.py backup | list-backups | restore <archive>). Keep DATA_ENCRYPTION_KEY
# (or data/platform/encryption.key) somewhere other than the backups.
BACKUP_DIR=
BACKUP_KEEP=14
BACKUP_INTERVAL_HOURS=24
