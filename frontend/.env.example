# Public origin of the website (no trailing slash). REQUIRED before deploying:
# drives canonical URLs, sitemap.xml, robots.txt, Open Graph URLs and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# FastAPI back end used by the workspaces and the contact form
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Optional: shown on the Contact page, footer and Organization structured data
NEXT_PUBLIC_CONTACT_EMAIL=
